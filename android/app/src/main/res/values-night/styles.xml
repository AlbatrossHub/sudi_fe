<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Deliberately the same as values/styles.xml. The app is light only
         (ThemeMode.light), so honouring the OS dark setting here just paints a
         black window for the third of a second before Flutter draws, and again
         behind the UI during transitions. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/sudi_ground</item>
    </style>
</resources>
