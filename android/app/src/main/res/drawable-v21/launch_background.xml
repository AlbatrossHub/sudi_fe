<?xml version="1.0" encoding="utf-8"?>
<!-- The landing screen the OS draws before Flutter has an engine.
     Ground colour plus the mark, matching lib/.../BootScreen so nothing jumps
     when Flutter takes over. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/sudi_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
